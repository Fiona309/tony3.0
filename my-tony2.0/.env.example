# mock：无需后端即可走完整流程；real：请求 frontend-backend-api-contract(4).md 中的接口
NEXT_PUBLIC_API_MODE=mock

# 同域联调保持 /api；后端独立运行时可改为 http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=/api

# 按量计费中转站（Claude / Whisper / TTS）；未设置时 API 路由走 mock
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://api.openai-next.com

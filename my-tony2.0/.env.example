# 前端环境变量模板（腾讯云部署）
# 用法：cp .env.example .env.local，改完必须重新 build 再 start——
# next.config.ts 的 rewrite 只在构建/启动时读一次 env，改了不重启不生效。

# real=接后端真实接口；mock=纯前端假数据。部署必须 real
NEXT_PUBLIC_API_MODE=real

# 【重要】必须是 /backend-api，不要填 /api。
# 仓库里 app/api/ 下还留着一批早期版本的路由（tts、analyze、whisper…），
# 它们会截胡 /api/* 的请求：实测填 /api 时 /api/color-matrix 返回 404、
# /api/tts 返回 500（打到前端旧路由上了）。填 /backend-api 走
# next.config.ts 的 rewrite 直达后端，实测全部 200。
NEXT_PUBLIC_API_BASE_URL=/backend-api

# 后端地址，给 next.config.ts 的 rewrite 用（/backend-api/* 和 /media/*）。
# 服务端变量，不带 NEXT_PUBLIC_ 前缀，不会泄露到浏览器。
# 转场跟拍的模板视频靠 /media/* 同源代理取，填错会导致模板全黑、时长 0:00。
BACKEND_ORIGIN=http://127.0.0.1:8000

# ============ 下面两个当前用不到 ============
# 只有 app/api/* 那批旧路由读它们，而 app/tony/ 主流程一个都没调用
# （已全部改走后端）。保持留空即可，不要在这里写真实 key。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.openai-next.com

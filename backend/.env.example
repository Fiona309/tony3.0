# 后端环境变量模板（腾讯云部署）
# 用法：cp .env.example .env，然后把 <填你的...> 换成真实值。
# .env 已在 .gitignore 里，不会进仓库。真实 key 永远不要写进这个模板文件。

# ============ 基础 ============
# 必须 false，否则全站走假数据
MOCK_MODELS=false

# 监听地址。用 Nginx 反代时填 127.0.0.1；容器里直接暴露时填 0.0.0.0
HOST=127.0.0.1
PORT=8000

# 允许跨域的前端地址，逗号分隔，要带协议、不要带结尾斜杠。
# 前后端同域 + Nginx 反代时，这项其实用不到，但填上没坏处。
CORS_ORIGINS=https://<填你的域名>

# 数据目录。不设则默认 backend/data（仓库里那份，含全部业务表和素材），
# 通常不用配。只有当你想把数据放到云盘挂载点时才设。
# DATA_DIR=/data/tony

# ============ 按量计费站（发色识别 / 语音 / 问答 / 生图）============
OPENAI_NEXT_BASE_URL=https://api.openai-next.com
OPENAI_NEXT_API_KEY=<填你的按量站 key>

# 发色识别 + 教程问答
VISION_PROVIDER=openai_next
VISION_MODEL=gpt-4o

# 语音识别
ASR_PROVIDER=openai_next
CLOUD_ASR_MODEL=whisper-large-v3-turbo

# 教程语音合成。TTS_API_KEY 不用单独填，config.py 会自动回落到
# 上面的 OPENAI_NEXT_API_KEY。
# 注意：TTS_PROVIDER 必须是 openai_next。填 browser_fallback 会退回浏览器
# 内置合成——就是那个机械女声，和 App 里其他地方的声线对不上。
TTS_PROVIDER=openai_next
TTS_BASE_URL=https://api.openai-next.com
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry

# 生图（走按量站的同一个 gemini 模型）
OPENROUTER_BASE_URL=https://api.openai-next.com/v1
OPENROUTER_API_KEY=<填你的按量站 key，和上面同一个>
OPENROUTER_IMAGE_MODEL=gemini-2.5-flash-image

# Embedding：留空时 KB 检索自动退回 SQLite 关键词匹配，
# 功能正常，只是没有语义检索。不想额外开 SiliconFlow 账号就保持留空。
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
SILICONFLOW_API_KEY=

# ============ 按次计费站（转场视频生成）============
DRAW_BASE_URL=https://draw.openai-next.com
DRAW_API_KEY=<填你的按次站 key>
TRANSITION_VIDEO_PROVIDER=wan
TRANSITION_VIDEO_MODEL=wan2.2-kf2v-flash
TRANSITION_VIDEO_WAN_RESOLUTION=480P

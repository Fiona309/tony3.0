# 基础运行模式
MOCK_MODELS=false
VISION_PROVIDER=openai_next
TRANSITION_VIDEO_PROVIDER=wan
TRANSITION_VIDEO_MODEL=wan2.2-kf2v-flash
TRANSITION_VIDEO_ENDPOINT=/v1/video/generations
TRANSITION_VIDEO_WAN_RESOLUTION=480P

# 图像识别 / 语音问答 / 视频生成所需 Key
# 按实际供应商填写，不能提交真实密钥。
OPENAI_NEXT_BASE_URL=https://api.openai-next.com
OPENAI_NEXT_API_KEY=
DRAW_BASE_URL=https://openai-next.apifox.cn
DRAW_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# RAG / embedding
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_API_KEY=
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ASR / TTS
# openai_next = 云端 whisper-large-v3-turbo（默认，复用 OPENAI_NEXT_API_KEY）
# siliconflow = 云端 SenseVoiceSmall（免费，需 SILICONFLOW_API_KEY）
# sensevoice  = 本地推理，需 pip install -r backend/requirements-local-asr.txt 且需安装 ffmpeg
ASR_PROVIDER=openai_next
CLOUD_ASR_MODEL=whisper-large-v3-turbo
SENSEVOICE_DEVICE=cpu
TTS_PROVIDER=browser_fallback

# 并发（P0）
REQUEST_WORKER_THREADS=64
PREVIEW_WORKER_COUNT=2
AFTER_VIDEO_WORKER_COUNT=2

# 超时分级（P1）—— 小请求不再等满 30 秒
LLM_FAST_TIMEOUT_SECONDS=8
LLM_ANSWER_TIMEOUT_SECONDS=15
EMBEDDING_TIMEOUT_SECONDS=10
VISION_TIMEOUT_SECONDS=30

# vision 图片瘦身（P1）
VISION_IMAGE_MAX_EDGE=1024
VISION_IMAGE_QUALITY=85
VISION_IMAGE_DETAIL=high

# 视频轮询间隔（P1）—— 原为硬编码 30 秒
TRANSITION_VIDEO_POLL_INTERVAL_SECONDS=5
